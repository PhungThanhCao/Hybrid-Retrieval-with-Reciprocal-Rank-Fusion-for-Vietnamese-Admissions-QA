# ===================================
# GEMINI API
# ===================================
GEMINI_API_KEY=tự thêm
GEMINI_MODEL=gemini-2.5-flash-lite

# ===================================
# EMBEDDING MODEL (LOCAL)
# ===================================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# ===================================
# HYBRID SEARCH
# ===================================
DENSE_TOP_K=10
SPARSE_TOP_K=10
FINAL_TOP_K=5

# RRF Fusion
RRF_K=60

# ===================================
# DOCUMENT PROCESSING
# ===================================
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ===================================
# FILE STORAGE (NO DATABASE)
# ===================================
DOCUMENTS_DIR=../data/documents
INDEX_DIR=../data/indexes

FAISS_INDEX_PATH=../data/indexes/faiss.index
BM25_INDEX_PATH=../data/indexes/bm25.pkl
CHUNKS_PATH=../data/indexes/chunks.json

# ===================================
# FASTAPI
# ===================================
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ===================================
# CORS
# ===================================
FRONTEND_URL=http://localhost:5173